# ==============================================================================
# .gitignore — Complaint Intelligence Platform
# ==============================================================================

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyc
*.pyo
*.pyd
.Python
MANIFEST

# Packaging
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg

# ── Virtual Environments ──────────────────────────────────────────────────────
venv/
env/
ENV/
.venv/
backend/venv/
backend/env/

# ── Environment / Secrets ─────────────────────────────────────────────────────
# Never commit real credentials. Use .env.example for templates.
.env
backend/.env
*.pem
*.key
secrets/

# ── Database Files ────────────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.db-shm
*.db-wal
complaint_intelligence.db

# ── Testing & Coverage ────────────────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
coverage/
htmlcov/
.tox/
nosetests.xml

# ── Node / Frontend ───────────────────────────────────────────────────────────
node_modules/
frontend/node_modules/
frontend/dist/
frontend/build/
.pnpm-store/
.yarn/cache/
.yarn/unplugged/
.npm/

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.idea/
*.swp
*.swo
*~
*.orig

# ── OS ────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log
logs/
*.log.*

# ── Generated Data (large, reproducible) ─────────────────────────────────────
# These files are excluded because they are deterministically regenerated from
# seed 20261022 using: python cli.py generate --scale full --seed 20261022 --clear --export
# The .gitkeep files mark the directories so they exist after clone.
backend/data/baseline/csv/*.csv
backend/data/baseline/json/*.json
backend/data/baseline/sql/*.sql
!backend/data/baseline/csv/.gitkeep
!backend/data/baseline/json/.gitkeep
!backend/data/baseline/sql/.gitkeep

# Ephemeral exports (not required for submission)
backend/data/exports/
backend/data/manifests/

# ── Docker Volumes ────────────────────────────────────────────────────────────
docker-data/
.docker/

# ── Type Checkers & Linters ───────────────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.ruff_cache/
.pytype/

# ── Misc ─────────────────────────────────────────────────────────────────────
*.bak
*.tmp
*.temp
.cache/
tmp/
temp/
