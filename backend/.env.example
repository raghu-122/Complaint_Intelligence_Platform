# Application
DATABASE_URL=sqlite:///./complaint_intelligence.db
DATABASE_ECHO=false

# API
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
SECRET_KEY=change-me-in-production-32-chars-min

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Generator defaults
DEFAULT_SEED=20261022
DEFAULT_SCALE=starter

# Optional: PostgreSQL (not required)
# DATABASE_URL=postgresql://user:password@localhost:5432/complaint_intelligence

# Optional: External LLM (not required for core functionality)
# OPENAI_API_KEY=
